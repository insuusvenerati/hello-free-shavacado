{
  "name": "hello-free-shavacado",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "run-s build:*",
    "build:worker": "esbuild ./app/entry.workbox.ts --outfile=./public/entry.workbox.js --minify --bundle --platform=node --format=esm --define:process.env.NODE_ENV='\"production\"'",
    "build:webworker": "esbuild ./app/utils/worker.ts --outfile=./public/worker.js --minify --bundle --format=esm --define:process.env.NODE_ENV='\"production\"'",
    "build:remix": "cross-env NODE_ENV=production remix vite:build",
    "dev": "run-p dev:*",
    "dev:webworker": "esbuild ./app/utils/worker.ts --outfile=./public/worker.js --bundle --format=esm --watch",
    "dev:remix": "cross-env NODE_ENV=development remix vite:dev",
    "format": "prettier --write .",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc -b",
    "validate": "run-p lint typecheck",
    "clean": "rimraf build/ public/build",
    "semantic-release": "semantic-release"
  },
  "eslintIgnore": [
    "/node_modules",
    "/build",
    "/public/build",
    "/recipe-data-scraper",
    "/patches",
    "/test-results",
    "/playwright-report",
    "/public/entry.worker.js"
  ],
  "dependencies": {
    "@epic-web/cachified": "^5.2.0",
    "@mantine/hooks": "^6.0.19",
    "@prisma/client": "^5.13.0",
    "@remix-pwa/push": "2.10.1",
    "@remix-pwa/sw": "^3.0.5",
    "@remix-pwa/worker-runtime": "^2.1.1",
    "@remix-run/node": "2.9.2",
    "@remix-run/react": "2.9.2",
    "@remix-run/serve": "2.9.2",
    "@remix-run/server-runtime": "2.9.2",
    "@sentry/integrations": "^7.114.0",
    "@sentry/remix": "^7.114.0",
    "axios": "1.6.8",
    "bcryptjs": "^2.4.3",
    "cheerio": "1.0.0-rc.12",
    "cloudinary": "^2.2.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "daisyui": "^4.11.1",
    "dotenv": "^16.4.5",
    "isbot": "^5.1.6",
    "iso8601-duration": "^2.1.2",
    "lru-cache": "^10.2.2",
    "lucide-react": "^0.378.0",
    "microdata-node": "^2.0.0",
    "npm-run-all": "^4.1.5",
    "nprogress": "^0.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-toastify": "^10.0.5",
    "recipe-data-scraper": "1.4.1",
    "remix": "2.9.2",
    "remix-flat-routes": "^0.6.5",
    "remix-typedjson": "^0.4.1",
    "remix-utils": "^7.6.0",
    "tailwind-merge": "^2.3.0",
    "tiny-invariant": "^1.3.3",
    "workbox-background-sync": "^7.1.0",
    "workbox-routing": "^7.1.0",
    "workbox-strategies": "^7.1.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.0.2",
    "@remix-pwa/dev": "^3.0.5",
    "@remix-run/dev": "2.9.2",
    "@remix-run/eslint-config": "2.9.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/eslint": "^8.56.10",
    "@types/node": "^20.12.11",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@types/semantic-release": "^20.0.6",
    "autoprefixer": "^10.4.19",
    "binode": "^1.0.5",
    "c8": "^9.1.0",
    "concurrently": "^8.2.2",
    "cookie": "^0.6.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.21.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "happy-dom": "^14.10.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "nodemon": "^3.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.2.5",
    "prisma": "^5.13.0",
    "rimraf": "^5.0.6",
    "semantic-release": "^23.1.1",
    "tailwindcss": "^3.4.3",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.9.5",
    "typescript": "5.4.5",
    "vite": "^5.2.11",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "engines": {
    "node": ">=18"
  },
  "prisma": {
    "seed": "npx tsx --experimental-fetch prisma/seed.ts"
  },
  "volta": {
    "node": "20.13.1",
    "pnpm": "8.6.12"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --cache --cache-location ./node_modules/.cache/eslint .",
      "prettier --write"
    ]
  },
  "pnpm": {
    "patchedDependencies": {
      "recipe-data-scraper@1.4.1": "patches/recipe-data-scraper@1.4.1.patch"
    }
  },
  "version": "0.0.0-development",
  "repository": {
    "type": "git",
    "url": "https://github.com/insuusvenerati/hello-free-shavacado.git"
  }
}
